# Project Mate Backend Environment Configuration

# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:4200

# PostgreSQL Database Configuration
# Replace with your local PostgreSQL credentials
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/project_mate?schema=public"

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_project_mate_change_me_in_production
JWT_EXPIRES_IN=7d

# Logging & Monitoring
LOG_LEVEL=dev

# Email (Resend)
RESEND_API_KEY=re_your_api_key_here
# EMAIL_FROM=Project Mate <onboarding@resend.dev>
